# =============================================================================
# Vault VFS App — Environment Variables
# Copy this file to `.env` and adjust values for your environment.
# =============================================================================

# --- HTTP Daemon (inbound_http extension) ---
VAULT_HOST=127.0.0.1
VAULT_PORT=8787

# --- Vault Identity & Local Persistence ---
VAULT_ID=default
VAULT_DEVICE_ID=vault-desktop-01
VAULT_DB_PATH=./data/vault_catalog.db
VAULT_DEVICE_KEY_PATH=./data/device.key

# --- App-Specific Vault & Partitions Config (read via yaml_file datasource) ---
VAULT_CONFIG_PATH=./configs/vault.yaml

# --- Google Drive Credentials ---
# Folder containing Service Account JSON files for initial import (Provisioner).
# Once imported into the encrypted catalog DB, credentials are loaded from SQLite.
VAULT_SA_KEYS_DIR=./sa_keys

# Single bootstrap credential (SA JSON or OAuth2) used for disaster-recovery `Vault.open`
# when `vault_catalog.db` does not exist locally yet.
VAULT_BOOTSTRAP_CRED=./sa_keys/vfs-sa-01.json
VAULT_NODE_ID=sa-01

