{
  "info": {
    "name": "Vault VFS Daemon API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8787" },
    { "key": "vaultId", "value": "default" },
    { "key": "inodeId", "value": "" },
    { "key": "parentId", "value": "" }
  ],
  "item": [
    {
      "name": "Init Vault (vault_init)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"device_id\":\"vault-desktop-01\"}" },
        "url": "{{baseUrl}}/tasks/vault_init"
      }
    },
    {
      "name": "Make Directory (vault_mkdir)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"parent_id\":\"{{parentId}}\",\"name\":\"docs\"}" },
        "url": "{{baseUrl}}/tasks/vault_mkdir"
      }
    },
    {
      "name": "List Directory (vault_ls)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"parent_id\":\"{{parentId}}\"}" },
        "url": "{{baseUrl}}/tasks/vault_ls"
      }
    },
    {
      "name": "Upload File (vault_upload)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"partition\":\"\",\"parent_id\":\"{{parentId}}\",\"name\":\"hello.txt\",\"data\":\"hello vault\"}" },
        "url": "{{baseUrl}}/tasks/vault_upload"
      }
    },
    {
      "name": "Read Range (vault_read)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"inode_id\":\"{{inodeId}}\",\"offset\":0,\"max_len\":65536}" },
        "url": "{{baseUrl}}/tasks/vault_read"
      }
    },
    {
      "name": "Delete Inode (vault_delete)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"inode_id\":\"{{inodeId}}\"}" },
        "url": "{{baseUrl}}/tasks/vault_delete"
      }
    },
    {
      "name": "Pool Quotas (vault_quotas)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\"}" },
        "url": "{{baseUrl}}/tasks/vault_quotas"
      }
    },
    {
      "name": "Run Garbage Collector (vault_gc)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\"}" },
        "url": "{{baseUrl}}/tasks/vault_gc"
      }
    },
    {
      "name": "Refresh Remote Catalog (vault_refresh)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\"}" },
        "url": "{{baseUrl}}/tasks/vault_refresh"
      }
    },
    {
      "name": "Rename / Move Inode (vault_rename)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"inode_id\":\"{{inodeId}}\",\"new_parent_id\":\"{{parentId}}\",\"new_name\":\"renamed.txt\"}" },
        "url": "{{baseUrl}}/tasks/vault_rename"
      }
    },
    {
      "name": "Write Packed Batch (vault_write_packed)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"parent_id\":\"{{parentId}}\",\"files_json\":\"[{\\\"name\\\":\\\"a.txt\\\",\\\"data\\\":\\\"aaa\\\"},{\\\"name\\\":\\\"b.txt\\\",\\\"data\\\":\\\"bbb\\\"}]\"}" },
        "url": "{{baseUrl}}/tasks/vault_write_packed"
      }
    },
    {
      "name": "Create Partition (vault_partition_create)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"name\":\"thumbs\",\"root_folder\":\"/thumbs\",\"quota_bytes\":5368709120,\"policy\":\"first_fit\"}" },
        "url": "{{baseUrl}}/tasks/vault_partition_create"
      }
    },
    {
      "name": "Resize Partition (vault_partition_resize)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"name\":\"thumbs\",\"new_quota_bytes\":10737418240}" },
        "url": "{{baseUrl}}/tasks/vault_partition_resize"
      }
    },
    {
      "name": "Get Metrics (vault_metrics)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\"}" },
        "url": "{{baseUrl}}/tasks/vault_metrics"
      }
    },
    {
      "name": "Enqueue Job (vault_jobs)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"vault_id\":\"{{vaultId}}\",\"kind\":\"sync\",\"target_path\":\"/\"}" },
        "url": "{{baseUrl}}/tasks/vault_jobs"
      }
    }
  ]
}
