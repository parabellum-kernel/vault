# =============================================================================
# Vault VFS App — Global Environment Variables
# Copy to `configs/.env` (or `.env`) to override defaults.
# Per-vault & partition settings live in `configs/pipeline.yaml` / `configs/vault.yaml`.
# =============================================================================

# --- HTTP Daemon (inbound_http extension) ---
VAULT_HOST=127.0.0.1
VAULT_PORT=8787

# --- Local Device Identity & Storage Paths ---
VAULT_DEVICE_ID=vault-desktop-01
VAULT_DEVICE_KEY_PATH=./data/device.key
VAULT_DATA_DIR=./data

# --- Google Drive Backend Credentials ---
VAULT_USER_KEY_PATH=./configs/user_keys/oauth_user.json
VAULT_SA_KEYS_DIR=./configs/sa_keys
VAULT_BOOTSTRAP_CRED=./configs/sa_keys/vfs-sa-01.json
